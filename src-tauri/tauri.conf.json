{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Go-Reviewer",
  "version": "0.1.0",
  "identifier": "com.goreviewer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Go-Reviewer · 智能围棋复盘",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../katago-v1.15.3-opencl-windows-x64": "katago"
    },
    "externalBin": ["binaries/go-reviewer-backend"],
    "category": "Game",
    "shortDescription": "AI Go review with KataGo",
    "longDescription": "Go-Reviewer is a desktop application for analyzing Go games using KataGo AI engine and large language models for natural-language commentary.",
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {}
}
