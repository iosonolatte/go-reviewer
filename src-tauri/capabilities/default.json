{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for go-reviewer desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "go-reviewer-backend",
          "sidecar": true,
          "args": [
            "--prod",
            "--port",
            { "validator": "\\S+" },
            "--host",
            { "validator": "\\S+" }
          ]
        }
      ]
    }
  ]
}
